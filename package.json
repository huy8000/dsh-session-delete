{
  "name": "dsh-session-delete",
  "version": "1.1.0",
  "description": "Permanently delete inactive DeepSeek Harness sessions; loaded sessions require the local idle-retirement Host patch.",
  "license": "MIT",
  "author": "huy8000",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "delete",
    "archive"
  ],
  "homepage": "https://github.com/huy8000/dsh-session-delete#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huy8000/dsh-session-delete.git"
  },
  "bugs": {
    "url": "https://github.com/huy8000/dsh-session-delete/issues"
  },
  "engines": {
    "dsh": "0.2.1-rc.2",
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check host.js && node --check client.js",
    "pack:check": "npm pack --dry-run"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "docs/*.md",
    "LICENSE",
    "patches/*.patch",
    "patches/README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2"
  }
}
